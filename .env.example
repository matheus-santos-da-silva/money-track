# Credenciais dos bancos de DESENVOLVIMENTO (docker-compose.dev.yml).
# Copie para .env e escolha senhas suas. O .env não é versionado.
USERS_DB_USER=users_dev
USERS_DB_PASSWORD=troque-esta-senha
FINANCE_DB_USER=finance_dev
FINANCE_DB_PASSWORD=troque-esta-senha

# Segredo JWT do docker-compose.infra.yml (modo produção local). Os dois serviços usam o mesmo.
JWT_SECRET=troque-este-segredo
